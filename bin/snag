#!/usr/bin/env ruby
# frozen_string_literal: true

require 'net/http'
require 'json'
require 'fileutils'
require 'digest'
require 'uri'
require 'tmpdir'
require 'shellwords'

SNAG_VERSION  = "1.1.1-ingrid"
SNAG_HOME     = File.expand_path("~/.snag")
SNAG_BIN      = File.join(SNAG_HOME, "bin")
SNAG_STORE    = File.join(SNAG_HOME, "store")
REGISTRY_URL  = "https://raw.githubusercontent.com/TDWolff-Developer-Org/Snag/refs/heads/latest/Formula/registry.json"
REGISTRY_PATH = File.join(SNAG_HOME, "registry.json")
INSTALLED_PATH = File.join(SNAG_HOME, "installed.json")
ALIASES_PATH   = File.join(SNAG_HOME, "aliases.json")
SNAG_VENVS     = File.join(SNAG_HOME, "venvs").freeze
SNAG_LOGS      = File.join(SNAG_HOME, "logs").freeze
SNAG_RAW_URL  = "https://raw.githubusercontent.com/TDWolff-Developer-Org/Snag/refs/heads/latest/bin/snag"
SNAG_CONTENT_HASH = Digest::SHA256.file(__FILE__).hexdigest.freeze

module Color
  RESET  = "\e[0m"
  RED    = "\e[31m"
  GREEN  = "\e[32m"
  YELLOW = "\e[33m"
  BLUE   = "\e[34m"
  CYAN   = "\e[36m"
  BOLD   = "\e[1m"

  DIM    = "\e[2m"

  def self.red(s)    = "#{RED}#{s}#{RESET}"
  def self.green(s)  = "#{GREEN}#{s}#{RESET}"
  def self.yellow(s) = "#{YELLOW}#{s}#{RESET}"
  def self.blue(s)   = "#{BLUE}#{s}#{RESET}"
  def self.cyan(s)   = "#{CYAN}#{s}#{RESET}"
  def self.bold(s)   = "#{BOLD}#{s}#{RESET}"
  def self.dim(s)    = "#{DIM}#{s}#{RESET}"
end

def step(msg)  = puts("#{Color.blue("==>")} #{Color.bold(msg)}")
def ok(msg)    = puts("#{Color.green("✓")} #{msg}")
def warn(msg)  = puts("#{Color.yellow("⚠")} #{msg}")
def error(msg) = puts("#{Color.red("✗")} #{msg}")
def info(msg)  = puts("  #{msg}")

def ensure_dirs
  [SNAG_HOME, SNAG_BIN, SNAG_STORE, SNAG_VENVS, SNAG_LOGS].each { |d| FileUtils.mkdir_p(d) }
  if active_venv
    [effective_bin, effective_store].each { |d| FileUtils.mkdir_p(d) }
  end
end

def write_crash_log(e)
  FileUtils.mkdir_p(SNAG_LOGS)
  timestamp = Time.now.strftime("%Y-%m-%dT%H-%M-%S")
  path = File.join(SNAG_LOGS, "crash-#{timestamp}.log")
  content = <<~LOG
    Snag Crash Report
    =================
    Date     : #{Time.now.utc}
    Version  : #{SNAG_VERSION} +#{SNAG_CONTENT_HASH[0..6]}
    Platform : #{PLATFORM}
    Command  : snag #{ARGV.join(" ")}
    Ruby     : #{RUBY_VERSION}

    Exception: #{e.class}
    Message  : #{e.message}

    Backtrace:
    #{e.backtrace&.map { |l| "  #{l}" }&.join("\n")}
  LOG
  File.write(path, content)
  path
rescue
  nil
end

def active_venv      = ENV["SNAG_VENV"]
def effective_bin    = active_venv ? File.join(SNAG_VENVS, active_venv, "bin")           : SNAG_BIN
def effective_store = active_venv ? File.join(SNAG_VENVS, active_venv, "store")        : SNAG_STORE
def effective_installed = active_venv ? File.join(SNAG_VENVS, active_venv, "installed.json") : INSTALLED_PATH

NO_CACHE_HEADERS = { "Cache-Control" => "no-cache", "Pragma" => "no-cache" }.freeze

def current_platform
  os  = `uname -s 2>/dev/null`.strip.downcase
  cpu = `uname -m 2>/dev/null`.strip.downcase
  os  = case os
        when "darwin" then "darwin"
        when "linux"  then "linux"
        else os
        end
  cpu = case cpu
        when "arm64", "aarch64" then "arm64"
        when "x86_64", "amd64"  then "x86_64"
        else cpu
        end
  "#{os}-#{cpu}"
rescue
  "unknown"
end

PLATFORM = current_platform.freeze

def fetch_url(url, limit = 5)
  raise "Too many redirects" if limit == 0
  uri = URI.parse(url)
  response = Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == 'https') do |http|
    req = Net::HTTP::Get.new(uri.request_uri)
    NO_CACHE_HEADERS.each { |k, v| req[k] = v }
    http.request(req)
  end
  case response.code
  when "200" then response.body
  when "301", "302", "307", "308" then fetch_url(response['location'], limit - 1)
  else raise "HTTP #{response.code}: #{url}"
  end
end

def download_file(url, dest, limit = 5)
  raise "Too many redirects" if limit == 0
  uri = URI.parse(url)
  Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == 'https') do |http|
    http.request(Net::HTTP::Get.new(uri.request_uri)) do |response|
      case response.code
      when "301", "302", "307", "308"
        return download_file(response['location'], dest, limit - 1)
      when "200"
        File.open(dest, 'wb') { |f| response.read_body { |chunk| f.write(chunk) } }
      else
        raise "HTTP #{response.code}: #{url}"
      end
    end
  end
end

def verify_sha256(path, expected)
  step "Verifying SHA256"
  actual = Digest::SHA256.file(path).hexdigest
  if actual == expected
    ok "SHA256 verified"
    true
  else
    error "SHA256 mismatch"
    info "Expected: #{expected}"
    info "Got:      #{actual}"
    false
  end
end

def load_registry
  unless File.exist?(REGISTRY_PATH)
    warn "Registry not found. Run 'snag update' to fetch it."
    return {}
  end
  JSON.parse(File.read(REGISTRY_PATH))["packages"] || {}
rescue JSON::ParserError
  error "Registry is corrupted. Run 'snag update'."
  {}
end

def installed_version(name)
  dir = File.join(effective_store, name)
  return nil unless Dir.exist?(dir)
  versions = Dir.children(dir).sort
  versions.last
end

def install_path(name, version)
  File.join(effective_store, name, version)
end

# --- Install ledger (~/.snag/installed.json) ---

# Pure read of the ledger. No filesystem inference — that lives in
# migrate_installed_ledger which runs exactly once.
def load_installed
  return {} unless File.exist?(effective_installed)
  JSON.parse(File.read(effective_installed)) rescue {}
end

# One-time migration: if installed.json doesn't exist yet but store already
# has packages, mark them all as "explicit" so they're never auto-orphaned.
# Idempotent — re-running after the file exists is a no-op.
def migrate_installed_ledger
  return if File.exist?(INSTALLED_PATH)
  return unless Dir.exist?(SNAG_STORE)
  return if active_venv
  data = {}
  Dir.children(SNAG_STORE).each do |pkg|
    v = installed_version(pkg)
    next unless v
    data[pkg] = { "version" => v, "installed_as" => "explicit" }
  end
  save_installed(data) unless data.empty?
end

def save_installed(data)
  ensure_dirs
  File.write(effective_installed, JSON.pretty_generate(data) + "\n")
end

def mark_installed(name, version, reason)
  data = load_installed
  # Don't demote an explicit install to dependency
  if data[name] && data[name]["installed_as"] == "explicit" && reason == "dependency"
    reason = "explicit"
  end
  data[name] = { "version" => version, "installed_as" => reason }
  save_installed(data)
end

def unmark_installed(name)
  data = load_installed
  data.delete(name)
  save_installed(data)
end

# Walks the dep tree of every "explicit" package. Anything reachable is
# "needed". Anything marked "dependency" that isn't reachable is an orphan.
def find_orphans
  installed = load_installed
  packages  = load_registry
  needed    = []

  installed.each do |name, info|
    next unless info["installed_as"] == "explicit"
    queue = [name]
    until queue.empty?
      current = queue.shift
      next if needed.include?(current)
      needed << current
      next unless packages.key?(current)
      (packages[current]["depends_on"] || []).each { |d| queue << d }
    end
  end

  installed.keys.select do |name|
    installed[name]["installed_as"] == "dependency" && !needed.include?(name)
  end.sort
end

# --- Alias ledger (~/.snag/aliases.json) ---

def load_aliases
  return {} unless File.exist?(ALIASES_PATH)
  JSON.parse(File.read(ALIASES_PATH)) rescue {}
end

def save_aliases(data)
  ensure_dirs
  File.write(ALIASES_PATH, JSON.pretty_generate(data) + "\n")
end

def cmd_alias(package, alias_name)
  if package.nil?
    cmd_aliases
    return
  end

  if alias_name.nil?
    error "Usage: snag alias <package> <alias>"
    info  "       snag alias               (list all aliases)"
    exit 1
  end

  src_link = File.join(effective_bin, package)
  unless File.exist?(src_link) || File.symlink?(src_link)
    error "'#{package}' is not an installed binary."
    info  "Run 'snag list' to see what's installed."
    exit 1
  end

  real_target = File.realpath(src_link) rescue src_link

  alias_link = File.join(effective_bin, alias_name)
  if File.exist?(alias_link) || File.symlink?(alias_link)
    existing = load_aliases
    if existing.key?(alias_name)
      error "'#{alias_name}' is already an alias for '#{existing[alias_name]["package"]}'."
      info  "Run 'snag unalias #{alias_name}' first if you want to replace it."
    else
      error "'#{alias_name}' already exists in ~/.snag/bin/ and is not a snag alias."
    end
    exit 1
  end

  FileUtils.ln_sf(real_target, alias_link)

  aliases = load_aliases
  aliases[alias_name] = { "package" => package, "target" => real_target }
  save_aliases(aliases)

  ok "#{Color.cyan(alias_name)} → #{Color.cyan(package)}"
  info "You can now run: #{Color.bold(alias_name)}"
end

def cmd_aliases
  aliases = load_aliases
  if aliases.empty?
    puts "No aliases defined."
    info "Create one with: #{Color.cyan("snag alias <package> <name>")}"
    return
  end

  puts "#{Color.bold("Aliases:")} (#{aliases.size} total)"
  puts
  aliases.sort_by { |k, _| k }.each do |name, data|
    link   = File.join(effective_bin, name)
    active = File.exist?(link) || (File.symlink?(link) && File.exist?(link))
    status = active ? Color.green("active") : Color.red("broken")
    puts "  #{Color.cyan(name.ljust(18))} → #{data["package"]} [#{status}]"
  end
  puts
end

def cmd_unalias(alias_name)
  aliases = load_aliases
  unless aliases.key?(alias_name)
    error "'#{alias_name}' is not a known alias."
    info  "Run 'snag alias' to list all aliases."
    exit 1
  end

  FileUtils.rm_f(File.join(effective_bin, alias_name))
  aliases.delete(alias_name)
  save_aliases(aliases)

  ok "Alias #{Color.cyan(alias_name)} removed."
end

# --- Commands ---

def levenshtein(a, b)
  s, t = a.downcase, b.downcase
  d = Array.new(s.length + 1) { |i| Array.new(t.length + 1) { |j| i.zero? ? j : j.zero? ? i : 0 } }
  (1..s.length).each do |i|
    (1..t.length).each do |j|
      d[i][j] = s[i-1] == t[j-1] ? d[i-1][j-1] : 1 + [d[i-1][j], d[i][j-1], d[i-1][j-1]].min
    end
  end
  d[s.length][t.length]
end

def suggest_similar(name, candidates)
  return if candidates.empty?
  best = candidates.min_by { |c| levenshtein(name, c) }
  return unless best
  distance = levenshtein(name, best)
  if distance <= [name.length / 2, 3].max
    puts
    info "Are you trying to install #{Color.cyan(best)}?"
    info "Run: #{Color.bold("snag install #{best}")}"
  else
    info "Run 'snag search #{name}' to browse available packages."
  end
end

# Build a topologically-sorted install order: deps first, target last.
# Raises RuntimeError on cycles or missing packages.
def resolve_deps(name, packages, visiting = [], resolved = [])
  return resolved if resolved.include?(name)

  if visiting.include?(name)
    cycle = visiting[visiting.index(name)..] + [name]
    raise "Dependency cycle detected: #{cycle.join(" → ")}"
  end

  unless packages.key?(name)
    raise "Missing dependency: '#{name}' is not in the registry"
  end

  visiting = visiting + [name]
  deps = packages[name]["depends_on"] || []
  deps.each { |d| resolve_deps(d, packages, visiting, resolved) }
  resolved << name unless resolved.include?(name)
  resolved
end

def cmd_install(name, pinned_version = nil, target_reason = "explicit")
  if name.include?("@")
    name, pinned_version = name.split("@", 2)
  end

  packages = load_registry
  unless packages.key?(name)
    error "Package '#{name}' not found."
    suggest_similar(name, packages.keys)
    exit 1
  end

  begin
    install_order = resolve_deps(name, packages)
  rescue RuntimeError => e
    error e.message
    exit 1
  end

  deps = install_order[0..-2]
  unless deps.empty?
    info "#{Color.bold(name)} depends on: #{deps.map { |d| Color.cyan(d) }.join(", ")}"
    puts
  end

  install_order.each do |pkg_name|
    pin = pkg_name == name ? pinned_version : nil
    reason = pkg_name == name ? target_reason : "dependency"
    install_resolved(pkg_name, packages, pin, reason)
  end
end

def install_resolved(name, packages, pinned_version = nil, reason = "explicit")
  pkg            = packages[name]
  latest_version = pkg["version"]

  if pinned_version && pinned_version != latest_version
    error "Version #{pinned_version} of '#{name}' is not available."
    info  "Available version: #{Color.green(latest_version)}"
    info  "Install it with:   snag install #{name}@#{latest_version}"
    exit 1
  end

  version  = latest_version
  existing = installed_version(name)

  if existing == version
    ok "#{name} #{version} is already installed."
    mark_installed(name, version, reason)
    return
  end

  # Resolve URL and SHA256 — platform-specific binary or universal script
  if pkg["platforms"]
    platform_data = pkg["platforms"][PLATFORM]
    unless platform_data
      supported = pkg["platforms"].keys.join(", ")
      error "#{name} is not available for #{PLATFORM}."
      info  "Supported platforms: #{supported}"
      exit 1
    end
    pkg_url    = platform_data["url"]
    pkg_sha256 = platform_data["sha256"]
  else
    pkg_url    = pkg["url"]
    pkg_sha256 = pkg["sha256"]
  end

  step "Installing #{Color.bold(name)} #{version}#{active_venv ? Color.dim(" [venv: #{active_venv}]") : ""}"
  info pkg["description"]
  puts

  ensure_dirs
  dest_dir = install_path(name, version)
  FileUtils.mkdir_p(dest_dir)

  Dir.mktmpdir do |tmp|
    ext     = pkg_url.end_with?(".tar.xz") ? ".tar.xz" : ".tar.gz"
    tarball = File.join(tmp, "#{name}-#{version}#{ext}")
    download_file(pkg_url, tarball)
    puts

    unless verify_sha256(tarball, pkg_sha256)
      FileUtils.rm_rf(dest_dir)
      exit 1
    end

    step "Extracting"
    result = system("tar", "-xf", tarball, "-C", dest_dir, "--strip-components=1")
    unless result
      error "Extraction failed."
      FileUtils.rm_rf(dest_dir)
      exit 1
    end
    ok "Extracted to #{dest_dir}"
  end

  if pkg["binaries"]
    # Explicit binary list — used for third-party tarballs that don't have a bin/ dir
    pkg["binaries"].each do |b|
      src = File.join(dest_dir, b)
      unless File.exist?(src)
        warn "Binary not found in tarball: #{b}"
        next
      end
      link_name = File.basename(b)
      link = File.join(effective_bin, link_name)
      FileUtils.chmod(0o755, src)
      FileUtils.ln_sf(src, link)
      ok "Linked #{Color.cyan(link_name)} → #{effective_bin}/"
    end
  else
    # Default: symlink everything in bin/
    bin_dir = File.join(dest_dir, "bin")
    if Dir.exist?(bin_dir)
      Dir.each_child(bin_dir) do |bin|
        src  = File.join(bin_dir, bin)
        link = File.join(effective_bin, bin)
        FileUtils.chmod(0o755, src)
        FileUtils.ln_sf(src, link)
        ok "Linked #{Color.cyan(bin)} → #{effective_bin}/"
      end
    end
  end

  mark_installed(name, version, reason)

  puts
  ok "#{Color.bold(name)} #{version} installed successfully!"
end

# Raw uninstall — no orphan check or prompt. Used by cmd_uninstall (which adds
# the orphan prompt) and by upgrade flows that need to remove + reinstall
# without surfacing an unrelated cleanup question to the user.
def uninstall_one(name)
  version = installed_version(name)
  return false unless version

  step "Uninstalling #{Color.bold(name)} #{version}"
  dest_dir = install_path(name, version)

  packages = load_registry
  pkg = packages[name]

  if pkg && pkg["binaries"]
    pkg["binaries"].each do |b|
      link_name = File.basename(b)
      link = File.join(effective_bin, link_name)
      next unless File.symlink?(link) || File.exist?(link)
      FileUtils.rm_f(link)
      ok "Removed #{link_name}"
    end
  else
    bin_dir = File.join(dest_dir, "bin")
    if Dir.exist?(bin_dir)
      Dir.each_child(bin_dir) do |bin|
        link = File.join(effective_bin, bin)
        FileUtils.rm_f(link)
        ok "Removed #{bin}"
      end
    end
  end

  FileUtils.rm_rf(File.join(SNAG_STORE, name))
  unmark_installed(name)
  ok "#{Color.bold(name)} uninstalled."
  true
end

def cmd_uninstall(name)
  unless installed_version(name)
    error "#{name} is not installed."
    exit 1
  end

  uninstall_one(name)

  # Warn about aliases that now point at nothing
  all_aliases = load_aliases
  affected    = all_aliases.select { |_, v| v["package"] == name }
  if affected.any?
    puts
    warn "Aliases pointing to #{Color.cyan(name)}: #{affected.keys.map { |a| Color.cyan(a) }.join(", ")}"
    print "  Remove them too? [y/N] "
    answer = $stdin.gets&.strip&.downcase
    if %w[y yes].include?(answer)
      affected.each_key do |a|
        FileUtils.rm_f(File.join(effective_bin, a))
        all_aliases.delete(a)
        ok "Removed alias #{Color.cyan(a)}"
      end
      save_aliases(all_aliases)
    else
      info "Left as broken symlinks. Run 'snag unalias <name>' to clean up later."
    end
  end

  orphans = find_orphans
  return if orphans.empty?

  puts
  info "Orphaned dependencies (no longer needed): #{orphans.map { |o| Color.cyan(o) }.join(", ")}"
  print "  Remove them too? [y/N] "
  answer = $stdin.gets&.strip&.downcase
  if %w[y yes].include?(answer)
    puts
    orphans.each { |o| uninstall_one(o); puts }
    ok "#{orphans.size} orphaned package(s) removed."
  else
    info "Run 'snag autoremove' later to clean them up."
  end
end

def cmd_autoremove
  orphans = find_orphans
  if orphans.empty?
    ok "No orphaned dependencies to remove."
    return
  end

  puts
  info "Orphaned dependencies: #{orphans.map { |o| Color.cyan(o) }.join(", ")}"
  print "  Remove all? [y/N] "
  answer = $stdin.gets&.strip&.downcase
  unless %w[y yes].include?(answer)
    info "Cancelled."
    return
  end

  puts
  orphans.each { |o| uninstall_one(o); puts }
  ok "#{orphans.size} package(s) removed."
end

def cmd_list
  venv_label = active_venv ? " #{Color.dim("[venv: #{active_venv}]")}" : ""
  unless Dir.exist?(effective_store)
    puts "Nothing installed yet#{venv_label}. Try 'snag search' or 'snag info <package>'."
    return
  end

  pkgs = Dir.children(effective_store).select { |d| Dir.exist?(File.join(effective_store, d)) }.sort
  if pkgs.empty?
    puts "Nothing installed yet#{venv_label}. Try 'snag search' or 'snag info <package>'."
    return
  end

  installed = load_installed
  puts "#{Color.bold("Installed packages:")} (#{pkgs.size} total)#{venv_label}"
  puts
  pkgs.each do |name|
    v = installed_version(name)
    reason = installed.dig(name, "installed_as") || "explicit"
    tag = reason == "dependency" ? Color.yellow(" [dep]") : ""
    puts "  #{Color.cyan(name.ljust(18))} #{v}#{tag}"
  end
  puts
end

def cmd_search(query = nil)
  packages = load_registry.select do |_, pkg|
    pkg["platforms"].nil? || pkg["platforms"].key?(PLATFORM)
  end
  show_all = query.nil? || query == "*"

  results = if show_all
    packages
  else
    packages.select do |name, pkg|
      name.downcase.include?(query.downcase) ||
        pkg["description"].downcase.include?(query.downcase)
    end
  end

  if results.empty?
    warn "No packages matching '#{query}'."
    return
  end

  header = show_all ? "All available packages:" : "Search results for '#{query}':"
  puts "#{Color.bold(header)} (#{results.size} found)"
  puts
  results.sort_by { |k, _| k }.each do |name, pkg|
    installed = installed_version(name)
    tag = installed ? Color.green(" [installed]") : ""
    puts "  #{Color.cyan(name.ljust(18))} #{pkg["version"].ljust(10)} #{pkg["description"]}#{tag}"
  end
  puts
end

def cmd_info(name)
  packages = load_registry
  unless packages.key?(name)
    error "Package '#{name}' not found."
    exit 1
  end

  pkg       = packages[name]
  installed = installed_version(name)

  puts
  puts "  #{Color.bold(Color.cyan(name))}"
  puts "  #{"─" * [name.length, 30].min}"
  puts "  Description : #{pkg["description"]}"
  puts "  Version     : #{pkg["version"]}"
  puts "  Homepage    : #{pkg["homepage"] || "N/A"}"
  deps = pkg["depends_on"] || []
  puts "  Depends on  : #{deps.empty? ? Color.cyan("none") : deps.map { |d| Color.cyan(d) }.join(", ")}"
  if pkg["platforms"]
    puts "  Type        : binary"
    puts "  Platforms   : #{pkg["platforms"].keys.join(", ")}"
    pdata = pkg["platforms"][PLATFORM]
    if pdata
      puts "  URL         : #{pdata["url"]}"
      puts "  SHA256      : #{pdata["sha256"]}"
    else
      puts "  #{Color.yellow("Not available for #{PLATFORM}")}"
    end
  else
    puts "  Type        : script"
    puts "  URL         : #{pkg["url"]}"
    puts "  SHA256      : #{pkg["sha256"]}"
  end
  puts "  Installed   : #{installed ? Color.green(installed) : Color.yellow("No")}"
  puts
end

def cmd_outdated
  packages = load_registry
  if packages.empty?
    warn "Registry empty. Run 'snag update'."
    return
  end

  unless Dir.exist?(effective_store)
    puts "Nothing installed yet."
    return
  end

  outdated = Dir.children(effective_store).sort.filter_map do |name|
    next unless packages.key?(name)
    current = installed_version(name)
    latest  = packages[name]["version"]
    next if current == latest
    { name: name, current: current, latest: latest }
  end

  if outdated.empty?
    ok "All packages are up to date."
    return
  end

  puts "#{Color.bold("Outdated packages:")} (#{outdated.size})"
  puts
  outdated.each do |pkg|
    puts "  #{Color.cyan(pkg[:name].ljust(18))} #{Color.yellow(pkg[:current])} → #{Color.green(pkg[:latest])}"
  end
  puts
  puts "  Run #{Color.cyan("snag upgrade")} to update all, or #{Color.cyan("snag upgrade <package>")} for one."
  puts
end

def cmd_upgrade(name = nil)
  packages = load_registry
  if packages.empty?
    warn "Registry empty. Run 'snag update' first."
    return
  end

  targets = if name
    unless packages.key?(name)
      error "Package '#{name}' not found."
      exit 1
    end
    [name]
  else
    Dir.exist?(effective_store) ? Dir.children(effective_store).select { |d| packages.key?(d) }.sort : []
  end

  if targets.empty?
    puts "Nothing installed yet."
    return
  end

  upgraded = 0
  targets.each do |pkg_name|
    current = installed_version(pkg_name)
    latest  = packages[pkg_name]["version"]

    if current.nil?
      puts
      step "Installing #{Color.bold(pkg_name)} #{Color.green(latest)} (not yet installed)"
      cmd_install(pkg_name)
      upgraded += 1
      next
    end

    if current == latest
      ok "#{pkg_name} #{current} is already up to date."
      next
    end

    puts
    step "Upgrading #{Color.bold(pkg_name)} #{Color.yellow(current)} → #{Color.green(latest)}"
    prior_reason = load_installed.dig(pkg_name, "installed_as") || "explicit"
    uninstall_one(pkg_name)
    cmd_install(pkg_name, nil, prior_reason)
    upgraded += 1
  end

  puts
  ok "#{upgraded} package(s) upgraded." if upgraded > 0
end

def cmd_update
  step "Updating package registry"
  ensure_dirs

  # Use curl for all update fetches — it bypasses CDN caches reliably
  unless system("command -v curl > /dev/null 2>&1")
    error "curl is required for updates but was not found."
    exit 1
  end

  registry_tmp = File.join(SNAG_HOME, "registry.json.tmp")
  result = system("curl", "-fsSL",
                  "-H", "Cache-Control: no-cache",
                  "-H", "Pragma: no-cache",
                  REGISTRY_URL, "-o", registry_tmp)
  remote_snag_version = nil
  remote_snag_sha256  = nil
  if result && File.exist?(registry_tmp)
    begin
      parsed = JSON.parse(File.read(registry_tmp))
      pkg_count = parsed["packages"]&.size || 0
      remote_snag_version = parsed["snag_version"]
      remote_snag_sha256  = parsed["snag_sha256"]
      FileUtils.mv(registry_tmp, REGISTRY_PATH)
      ok "Registry updated"
    rescue JSON::ParserError
      FileUtils.rm_f(registry_tmp)
      error "Downloaded registry is corrupted. Try again."
      exit 1
    end
  else
    FileUtils.rm_f(registry_tmp)
    error "Failed to download registry."
    exit 1
  end

  puts
  step "Checking for snag updates"
  up_to_date = if remote_snag_sha256
    remote_snag_sha256 == SNAG_CONTENT_HASH
  elsif remote_snag_version
    remote_snag_version == SNAG_VERSION
  else
    warn "Registry has no snag_sha256 or snag_version field — skipping self-update check"
    true
  end

  if up_to_date
    ok "snag #{SNAG_VERSION} +#{SNAG_CONTENT_HASH[0..6]} is up to date"
  else
    label_from = "+#{SNAG_CONTENT_HASH[0..6]}"
    label_to   = remote_snag_sha256 ? "+#{remote_snag_sha256[0..6]}" : remote_snag_version
    info "Updating snag #{Color.yellow(label_from)} → #{Color.green(label_to)}"
    begin
      snag_tmp = File.join(SNAG_HOME, "snag.tmp")
      result = system("curl", "-fsSL",
                      "-H", "Cache-Control: no-cache",
                      "-H", "Pragma: no-cache",
                      SNAG_RAW_URL, "-o", snag_tmp)
      raise "curl failed" unless result && File.exist?(snag_tmp)

      FileUtils.mv(snag_tmp, __FILE__)
      FileUtils.chmod(0o755, __FILE__)
      ok "snag updated!"
    rescue => e
      FileUtils.rm_f(snag_tmp) rescue nil
      warn "Could not self-update: #{e.message}"
    end
  end

  # Upgrade any installed packages that have newer versions in the registry
  puts
  step "Upgrading installed packages"
  packages = load_registry
  upgraded = 0

  if Dir.exist?(effective_store)
    Dir.children(effective_store).sort.each do |pkg_name|
      current = installed_version(pkg_name)
      next unless current
      latest = packages.dig(pkg_name, "version")
      next unless latest

      if current == latest
        ok "#{pkg_name} #{current} is up to date"
      else
        warn "#{pkg_name} #{current} → #{Color.green(latest)}"
        prior_reason = load_installed.dig(pkg_name, "installed_as") || "explicit"
        uninstall_one(pkg_name)
        cmd_install(pkg_name, nil, prior_reason)
        upgraded += 1
      end
    end
  end

  if upgraded == 0
    ok "All packages up to date" unless Dir.exist?(effective_store) && !Dir.children(effective_store).empty?
  else
    puts
    ok "#{upgraded} package(s) upgraded."
  end
end

def dir_size(path)
  total = 0
  Dir.glob(File.join(path, "**", "*"), File::FNM_DOTMATCH).each do |f|
    total += File.size(f) if File.file?(f)
  end
  total
rescue
  0
end

def format_bytes(n)
  return "0 B" if n.nil? || n == 0
  units = %w[B KB MB GB]
  i = 0
  size = n.to_f
  while size >= 1024 && i < units.size - 1
    size /= 1024
    i += 1
  end
  "%.1f %s" % [size, units[i]]
end

def cmd_cleanup(dry_run = false)
  ensure_dirs
  puts
  puts "  #{Color.bold("snag cleanup")}#{dry_run ? " #{Color.yellow("(dry run)")}" : ""}"
  puts

  total_freed = 0
  removed_versions = 0

  # 1. Old versions in store
  step "Old package versions"
  if Dir.exist?(effective_store)
    Dir.children(effective_store).sort.each do |pkg|
      pkg_dir = File.join(effective_store, pkg)
      next unless Dir.exist?(pkg_dir)
      versions = Dir.children(pkg_dir).sort
      next if versions.size <= 1

      keep = versions.last
      versions[0..-2].each do |v|
        path = File.join(pkg_dir, v)
        size = dir_size(path)
        total_freed += size
        removed_versions += 1
        if dry_run
          info "Would remove #{Color.cyan(pkg)} #{Color.yellow(v)} (#{format_bytes(size)}) — keeping #{Color.green(keep)}"
        else
          FileUtils.rm_rf(path)
          ok "Removed #{Color.cyan(pkg)} #{Color.yellow(v)} (#{format_bytes(size)})"
        end
      end
    end
  end
  ok "No old versions to clean" if removed_versions == 0

  # 2. Broken symlinks in bin/ (alias symlinks are handled separately below)
  puts
  step "Broken symlinks"
  alias_names = load_aliases.keys
  broken = []
  if Dir.exist?(effective_bin)
    Dir.each_child(effective_bin) do |f|
      next if f == "snag"
      next if alias_names.include?(f)
      link = File.join(effective_bin, f)
      broken << f if File.symlink?(link) && !File.exist?(link)
    end
  end
  if broken.empty?
    ok "No broken symlinks"
  elsif dry_run
    broken.each { |f| info "Would remove broken symlink #{Color.yellow(f)}" }
  else
    broken.each do |f|
      FileUtils.rm_f(File.join(effective_bin, f))
      ok "Removed broken symlink #{Color.yellow(f)}"
    end
  end

  # 3. Dangling aliases
  puts
  step "Dangling aliases"
  all_aliases = load_aliases
  dangling = all_aliases.select { |aname, _|
    link = File.join(effective_bin, aname)
    File.symlink?(link) && !File.exist?(link)
  }
  if dangling.empty?
    ok "No dangling aliases"
  else
    dangling.each do |aname, data|
      if dry_run
        info "Would remove dangling alias #{Color.cyan(aname)} (was → #{data["package"]})"
      else
        FileUtils.rm_f(File.join(effective_bin, aname))
        all_aliases.delete(aname)
        ok "Removed dangling alias #{Color.cyan(aname)}"
      end
    end
    save_aliases(all_aliases) unless dry_run
  end

  # 4. Temp files
  puts
  step "Temporary files"
  tmp_files = Dir.glob(File.join(SNAG_HOME, "*.tmp"))
  if tmp_files.empty?
    ok "No temp files"
  else
    tmp_files.each do |f|
      size = File.size(f) rescue 0
      total_freed += size
      if dry_run
        info "Would remove #{f} (#{format_bytes(size)})"
      else
        FileUtils.rm_f(f)
        ok "Removed #{File.basename(f)} (#{format_bytes(size)})"
      end
    end
  end

  # 5. Old crash logs (keep newest 10)
  puts
  step "Crash logs"
  crash_logs = Dir.glob(File.join(SNAG_LOGS, "crash-*.log")).sort
  old_logs   = crash_logs.size > 10 ? crash_logs[0..-(11)] : []
  if old_logs.empty?
    ok "No old crash logs (#{crash_logs.size} kept)"
  else
    old_logs.each do |f|
      size = File.size(f) rescue 0
      total_freed += size
      if dry_run
        info "Would remove #{File.basename(f)} (#{format_bytes(size)})"
      else
        FileUtils.rm_f(f)
        ok "Removed #{File.basename(f)} (#{format_bytes(size)})"
      end
    end
  end

  puts
  if dry_run
    info "Dry run — nothing was removed."
    info "Run #{Color.cyan("snag cleanup")} (without --dry-run) to apply."
  elsif total_freed > 0
    ok "Freed #{Color.bold(format_bytes(total_freed))} total"
  else
    ok "Already clean"
  end
  puts
end

def cmd_doctor
  issues = 0

  check = lambda do |label, &block|
    result, detail = block.call
    if result
      puts "  #{Color.green("✓")} #{label}#{detail ? " — #{detail}" : ""}"
    else
      puts "  #{Color.red("✗")} #{label}#{detail ? " — #{detail}" : ""}"
      issues += 1
    end
  end

  puts
  puts "  #{Color.bold("snag doctor")} — checking your setup"
  puts

  # Ruby version
  check.call("Ruby installed") do
    version = RUBY_VERSION
    [true, "ruby #{version}"]
  end

  # snag binary is executable
  check.call("snag binary is executable") do
    [File.executable?(__FILE__), __FILE__]
  end

  # bin dir in PATH
  check.call("#{effective_bin} is in PATH") do
    in_path = ENV["PATH"].split(":").any? { |p| File.expand_path(p) == File.expand_path(effective_bin) }
    [in_path, in_path ? nil : "run: export PATH=\"#{effective_bin}:$PATH\""]
  end

  # Store directory exists
  check.call("Store directory exists") do
    [Dir.exist?(effective_store), effective_store]
  end

  # Registry exists and is valid
  check.call("Registry is present and valid") do
    if File.exist?(REGISTRY_PATH)
      begin
        JSON.parse(File.read(REGISTRY_PATH))
        [true, REGISTRY_PATH]
      rescue JSON::ParserError
        [false, "corrupted — run 'snag update'"]
      end
    else
      [false, "missing — run 'snag update'"]
    end
  end

  # No broken symlinks in bin (skip aliases — checked separately)
  doc_alias_names = load_aliases.keys
  broken = []
  if Dir.exist?(effective_bin)
    Dir.each_child(effective_bin) do |f|
      next if f == "snag"
      next if doc_alias_names.include?(f)
      link = File.join(effective_bin, f)
      broken << f if File.symlink?(link) && !File.exist?(link)
    end
  end
  check.call("No broken symlinks in #{effective_bin}") do
    broken.empty? ? [true, nil] : [false, "broken: #{broken.join(", ")} — run 'snag uninstall' and reinstall"]
  end

  # No dangling aliases
  dangling_aliases = load_aliases.select { |aname, _|
    link = File.join(effective_bin, aname)
    File.symlink?(link) && !File.exist?(link)
  }
  check.call("No dangling aliases") do
    if dangling_aliases.empty?
      [true, nil]
    else
      [false, "dangling: #{dangling_aliases.keys.join(", ")} — run 'snag cleanup' or 'snag unalias <name>'"]
    end
  end

  # Installed packages have their binaries
  if Dir.exist?(effective_store)
    Dir.each_child(effective_store) do |pkg|
      version = installed_version(pkg)
      next unless version
      bin_dir = File.join(install_path(pkg, version), "bin")
      check.call("#{pkg} #{version} has binaries") do
        [Dir.exist?(bin_dir) && !Dir.empty?(bin_dir), install_path(pkg, version)]
      end
    end
  end

  # Internet connectivity
  check.call("GitHub reachable") do
    begin
      fetch_url("https://github.com")
      [true, nil]
    rescue
      [false, "cannot reach github.com"]
    end
  end

  puts
  if issues == 0
    puts "  #{Color.green(Color.bold("All checks passed!"))}"
  else
    puts "  #{Color.red(Color.bold("#{issues} issue(s) found."))} Fix the errors above and run 'snag doctor' again."
  end
  puts
end

def cmd_self_uninstall
  puts
  puts "  #{Color.bold(Color.red("⚠  Uninstall Snag"))}"
  puts
  puts "  This will:"
  puts "    • Remove #{SNAG_HOME}"
  puts "    • Remove all installed packages"
  puts "    • Strip PATH entries from your shell config"
  puts
  print "  Are you sure? [y/N] "
  answer = $stdin.gets&.strip&.downcase
  unless %w[y yes].include?(answer)
    puts
    info "Uninstall cancelled."
    return
  end

  puts
  print "  #{Color.yellow("Are you REALLY sure?")} This cannot be undone. [y/N] "
  answer = $stdin.gets&.strip&.downcase
  unless %w[y yes].include?(answer)
    puts
    info "Uninstall cancelled."
    return
  end

  puts
  step "Removing #{SNAG_HOME}"
  if Dir.exist?(SNAG_HOME)
    FileUtils.rm_rf(SNAG_HOME)
    ok "Removed #{SNAG_HOME}"
  else
    warn "#{SNAG_HOME} does not exist"
  end

  step "Cleaning up shell config"
  shell_files = [
    File.expand_path("~/.zshrc"),
    File.expand_path("~/.bashrc"),
    File.expand_path("~/.bash_profile"),
    File.expand_path("~/.config/fish/config.fish"),
  ]

  shell_files.each do |rc|
    next unless File.exist?(rc)
    content = File.read(rc)
    new_content = content.lines.reject { |l|
      l.include?(".snag/bin") || l.strip == "# Snag package manager"
    }.join
    # Remove the multi-line venv shell function block
    new_content.gsub!(/\n?# snag venv shell integration\nsnag\(\) \{.*?\n\}\n?/m, "\n")
    new_content = new_content.gsub(/\n{3,}/, "\n\n")
    if content != new_content
      File.write(rc, new_content)
      ok "Cleaned #{rc}"
    end
  end

  puts
  ok "Snag uninstalled."
  info "Open a new terminal — the snag command will be gone."
  puts
end

VENV_SHELL_FN = <<~'SHELL'
  # snag venv shell integration
  snag() {
    if [[ "$1" == "venv" && ( "$2" == "activate" || "$2" == "deactivate" ) ]]; then
      eval "$(command snag "$@" --shell-eval)"
    else
      command snag "$@"
    fi
  }
SHELL

def cmd_venv(action, name = nil)
  shell_eval = ARGV.include?("--shell-eval")

  case action
  when "new"
    unless name
      error "Usage: snag venv new <name>"
      exit 1
    end
    venv_dir = File.join(SNAG_VENVS, name)
    if Dir.exist?(venv_dir)
      error "Venv '#{name}' already exists."
      exit 1
    end
    FileUtils.mkdir_p(File.join(venv_dir, "bin"))
    FileUtils.mkdir_p(File.join(venv_dir, "store"))
    File.write(File.join(venv_dir, "installed.json"), JSON.generate({}))
    ok "Created venv '#{Color.cyan(name)}'"
    info "Activate with: snag venv activate #{name}"

  when "activate"
    unless name
      error "Usage: snag venv activate <name>"
      exit 1
    end
    venv_dir = File.join(SNAG_VENVS, name)
    unless Dir.exist?(venv_dir)
      error "Venv '#{name}' does not exist. Create it with: snag venv new #{name}"
      exit 1
    end
    if shell_eval
      puts "export SNAG_VENV=#{name.shellescape}"
      puts "export SNAG_VENV_PREV_PATH=\"$PATH\""
      puts "export PATH=#{File.join(venv_dir, 'bin').shellescape}:\"$PATH\""
    else
      warn "Shell function not detected. Install it with: snag venv install-shell"
      info "Or manually run: eval \"$(command snag venv activate #{name} --shell-eval)\""
    end

  when "deactivate"
    if shell_eval
      puts 'if [ -n "$SNAG_VENV_PREV_PATH" ]; then export PATH="$SNAG_VENV_PREV_PATH"; unset SNAG_VENV_PREV_PATH; fi'
      puts "unset SNAG_VENV"
    else
      warn "Shell function not detected. Install it with: snag venv install-shell"
    end

  when "list", "ls"
    ensure_dirs
    venvs = Dir.exist?(SNAG_VENVS) ? Dir.children(SNAG_VENVS).sort : []
    if venvs.empty?
      info "No venvs yet. Create one with: snag venv new <name>"
    else
      puts "#{Color.bold("Venvs:")} (#{venvs.size} total)"
      puts
      venvs.each do |v|
        if active_venv == v
          puts "  #{Color.green("*")} #{Color.cyan(v)} #{Color.dim("(active)")}"
        else
          puts "    #{v}"
        end
      end
      puts
    end

  when "rm", "remove"
    unless name
      error "Usage: snag venv rm <name>"
      exit 1
    end
    venv_dir = File.join(SNAG_VENVS, name)
    unless Dir.exist?(venv_dir)
      error "Venv '#{name}' does not exist."
      exit 1
    end
    if active_venv == name
      error "Cannot remove the active venv. Deactivate first: snag venv deactivate"
      exit 1
    end
    FileUtils.rm_rf(venv_dir)
    ok "Removed venv '#{Color.cyan(name)}'"

  when "install-shell"
    configs = [
      File.expand_path("~/.zshrc"),
      File.expand_path("~/.bashrc"),
      File.expand_path("~/.bash_profile"),
    ].select { |f| File.exist?(f) }

    if configs.empty?
      warn "No shell config files found (~/.zshrc, ~/.bashrc, ~/.bash_profile)."
      exit 1
    end

    configs.each do |cfg|
      if File.read(cfg).include?("snag venv shell integration")
        info "Already present in #{cfg}"
      else
        File.open(cfg, "a") { |f| f.puts("\n#{VENV_SHELL_FN}") }
        ok "Added shell function to #{cfg}"
      end
    end
    info "Restart your shell or run: source ~/.zshrc"

  when nil
    error "Usage: snag venv <new|activate|deactivate|list|rm|install-shell>"
    exit 1

  else
    error "Unknown venv action: '#{action}'. Run 'snag help' for usage."
    exit 1
  end
end

def cmd_logs
  unless Dir.exist?(SNAG_LOGS)
    ok "No crash logs found."
    return
  end

  logs = Dir.glob(File.join(SNAG_LOGS, "crash-*.log")).sort.reverse
  if logs.empty?
    ok "No crash logs found."
    return
  end

  puts "#{Color.bold("Crash logs:")} (#{logs.size} total)"
  puts "  #{Color.dim(SNAG_LOGS)}"
  puts
  logs.each do |path|
    raw_size = File.size(path) rescue 0
    size = format_bytes(raw_size)
    puts "  #{Color.cyan(File.basename(path))}  #{Color.dim(size)}"
  end
  puts
  info "View a report: #{Color.cyan("cat #{SNAG_LOGS}/crash-<name>.log")}"
  info "Clear all logs: #{Color.cyan("snag cleanup")}"
end

def cmd_version
  puts "#{Color.bold("snag")} #{SNAG_VERSION} #{Color.dim("+#{SNAG_CONTENT_HASH[0..6]}")} #{Color.cyan("[#{PLATFORM}]")}"
  puts "Home     : #{SNAG_HOME}"
  puts "Store    : #{effective_store}"
  puts "Binary   : #{__FILE__}"
  puts "Platform : #{PLATFORM}"
  puts "Venv     : #{active_venv ? Color.cyan(active_venv) : Color.dim("none")}"
end


def cmd_help
  puts
  puts "  #{Color.bold(Color.cyan("snag"))} #{SNAG_VERSION} — a simple package manager"
  puts 
  puts "  #{Color.bold("About:")} Snag is a simple developer friendly package manager for small command-line tools. It installs packages as self-contained units, each with its own version and dependencies, and links their binaries into a single directory on your PATH."
  puts
  puts "  #{Color.bold("Usage:")} snag <command> [package]"
  puts
  puts "  #{Color.bold("Commands:")}"
  cmds = [
    ["install <package[@version]>", "Download and install a package"],
    ["uninstall <package>", "Remove an installed package"],
    ["upgrade [package]",   "Upgrade one package or all installed packages"],
    ["outdated",            "Show installed packages with newer versions available"],
    ["list",                "List installed packages"],
    ["search [query]",      "Search packages by name or description (omit query to list all)"],
    ["info <package>",      "Show detailed package info"],
    ["update",              "Refresh registry and self-update snag"],
    ["doctor",              "Check your snag installation for problems"],
    ["alias <package> <name>", "Create a short alias for an installed binary"],
    ["alias",                  "List all aliases"],
    ["unalias <name>",         "Remove an alias"],
    ["cleanup [--dry-run]",    "Remove old versions, broken symlinks, and temp files"],
    ["autoremove",             "Remove dependencies no longer required by any explicit package"],
    ["venv new <name>",         "Create a new isolated environment"],
    ["venv activate <name>",    "Activate a venv (requires shell function)"],
    ["venv deactivate",         "Deactivate the current venv"],
    ["venv list",               "List all venvs"],
    ["venv rm <name>",          "Remove a venv"],
    ["venv install-shell",      "Install shell function for transparent activation"],
    ["self-uninstall",         "Completely remove snag from this machine"],
    ["logs",               "List crash reports in ~/.snag/logs/"],
    ["version",             "Print version info"],
    ["help",                "Show this message"],
  ]
  cmds.each do |cmd, desc|
    puts "    #{Color.cyan(cmd.ljust(24))} #{desc}"
  end
  puts
  puts "  #{Color.bold("Examples:")}"
  puts "    snag install myip"
  puts "    snag install snagtools"
  puts "    snag search            # all available packages"
  puts "    snag search ip"
  puts "    snag info snagtools"
  puts "    snag update"
  puts "    snag venv new myproject"
  puts "    snag venv activate myproject"
  puts
end

# --- Entry point ---

begin
  migrate_installed_ledger

  command  = ARGV[0]
  argument = ARGV[1]

  case command
  when "install"
    argument ? cmd_install(argument) : (error "Usage: snag install <package>"; exit 1)
  when "uninstall", "remove", "rm"
    argument ? cmd_uninstall(argument) : (error "Usage: snag uninstall <package>"; exit 1)
  when "list", "ls"
    cmd_list
  when "search"
    cmd_search(argument)
  when "info"
    argument ? cmd_info(argument) : (error "Usage: snag info <package>"; exit 1)
  when "upgrade"
    cmd_upgrade(argument)
  when "outdated"
    cmd_outdated
  when "update"
    cmd_update
  when "doctor"
    cmd_doctor
  when "cleanup"
    cmd_cleanup(argument == "--dry-run")
  when "alias"
    cmd_alias(argument, ARGV[2])
  when "aliases"
    cmd_aliases
  when "unalias"
    argument ? cmd_unalias(argument) : (error "Usage: snag unalias <name>"; exit 1)
  when "autoremove"
    cmd_autoremove
  when "venv"
    if ARGV[1] == "-m"
      cmd_venv("new", ARGV[2])
    else
      cmd_venv(ARGV[1], ARGV[2])
    end
  when "self-uninstall", "--uninstall"
    cmd_self_uninstall
  when "logs"
    cmd_logs
  when "version", "--version", "-v"
    cmd_version
  when "help", "--help", "-h", nil
    cmd_help
  else
    error "Unknown command: '#{command}'. Run 'snag help' for usage."
    exit 1
  end
rescue => e
  error "snag crashed: #{e.message}"
  log_path = write_crash_log(e)
  info "Crash report saved to: #{log_path}" if log_path
  info "Run 'snag logs' to list all crash reports."
  exit 1
end
