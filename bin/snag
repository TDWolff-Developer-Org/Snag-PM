#!/usr/bin/env ruby
# frozen_string_literal: true

require 'net/http'
require 'json'
require 'fileutils'
require 'digest'
require 'uri'
require 'tmpdir'

SNAG_VERSION  = "0.0.2"
SNAG_HOME     = File.expand_path("~/.snag")
SNAG_BIN      = File.join(SNAG_HOME, "bin")
SNAG_CELLAR   = File.join(SNAG_HOME, "Cellar")
REGISTRY_URL  = "https://raw.githubusercontent.com/TDWolff-Developer-Org/Snag-PM/latest/Formula/registry.json"
REGISTRY_PATH = File.join(SNAG_HOME, "registry.json")
SNAG_RAW_URL  = "https://raw.githubusercontent.com/TDWolff-Developer-Org/Snag-PM/latest/bin/snag"

module Color
  RESET  = "\e[0m"
  RED    = "\e[31m"
  GREEN  = "\e[32m"
  YELLOW = "\e[33m"
  BLUE   = "\e[34m"
  CYAN   = "\e[36m"
  BOLD   = "\e[1m"

  def self.red(s)    = "#{RED}#{s}#{RESET}"
  def self.green(s)  = "#{GREEN}#{s}#{RESET}"
  def self.yellow(s) = "#{YELLOW}#{s}#{RESET}"
  def self.blue(s)   = "#{BLUE}#{s}#{RESET}"
  def self.cyan(s)   = "#{CYAN}#{s}#{RESET}"
  def self.bold(s)   = "#{BOLD}#{s}#{RESET}"
end

def step(msg)  = puts("#{Color.blue("==>")} #{Color.bold(msg)}")
def ok(msg)    = puts("#{Color.green("✓")} #{msg}")
def warn(msg)  = puts("#{Color.yellow("⚠")} #{msg}")
def error(msg) = puts("#{Color.red("✗")} #{msg}")
def info(msg)  = puts("  #{msg}")

def ensure_dirs
  [SNAG_HOME, SNAG_BIN, SNAG_CELLAR].each { |d| FileUtils.mkdir_p(d) }
end

NO_CACHE_HEADERS = { "Cache-Control" => "no-cache", "Pragma" => "no-cache" }.freeze

def fetch_url(url, limit = 5)
  raise "Too many redirects" if limit == 0
  uri = URI.parse(url)
  response = Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == 'https') do |http|
    req = Net::HTTP::Get.new(uri.request_uri)
    NO_CACHE_HEADERS.each { |k, v| req[k] = v }
    http.request(req)
  end
  case response.code
  when "200" then response.body
  when "301", "302", "307", "308" then fetch_url(response['location'], limit - 1)
  else raise "HTTP #{response.code}: #{url}"
  end
end

def download_file(url, dest, limit = 5)
  raise "Too many redirects" if limit == 0
  uri = URI.parse(url)
  Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == 'https') do |http|
    http.request(Net::HTTP::Get.new(uri.request_uri)) do |response|
      case response.code
      when "301", "302", "307", "308"
        return download_file(response['location'], dest, limit - 1)
      when "200"
        File.open(dest, 'wb') { |f| response.read_body { |chunk| f.write(chunk) } }
      else
        raise "HTTP #{response.code}: #{url}"
      end
    end
  end
end

def verify_sha256(path, expected)
  step "Verifying SHA256"
  actual = Digest::SHA256.file(path).hexdigest
  if actual == expected
    ok "SHA256 verified"
    true
  else
    error "SHA256 mismatch!"
    info "Expected: #{expected}"
    info "Got:      #{actual}"
    false
  end
end

def load_registry
  unless File.exist?(REGISTRY_PATH)
    warn "Registry not found. Run 'snag update' to fetch it."
    return {}
  end
  JSON.parse(File.read(REGISTRY_PATH))["packages"] || {}
rescue JSON::ParserError
  error "Registry is corrupted. Run 'snag update'."
  {}
end

def installed_version(name)
  dir = File.join(SNAG_CELLAR, name)
  return nil unless Dir.exist?(dir)
  versions = Dir.children(dir).sort
  versions.last
end

def install_path(name, version)
  File.join(SNAG_CELLAR, name, version)
end

# --- Commands ---

def cmd_install(name, pinned_version = nil)
  # Support snag install hello@1.0.0
  if name.include?("@")
    name, pinned_version = name.split("@", 2)
  end

  packages = load_registry
  unless packages.key?(name)
    error "Package '#{name}' not found. Try 'snag search #{name}' or 'snag list'."
    exit 1
  end

  pkg            = packages[name]
  latest_version = pkg["version"]

  if pinned_version && pinned_version != latest_version
    error "Version #{pinned_version} of '#{name}' is not available."
    info  "Available version: #{Color.green(latest_version)}"
    info  "Install it with:   snag install #{name}@#{latest_version}"
    exit 1
  end

  version  = latest_version
  existing = installed_version(name)

  if existing == version
    ok "#{name} #{version} is already installed."
    return
  end

  step "Installing #{Color.bold(name)} #{version}"
  info pkg["description"]
  puts

  ensure_dirs
  dest_dir = install_path(name, version)
  FileUtils.mkdir_p(dest_dir)

  Dir.mktmpdir do |tmp|
    tarball = File.join(tmp, "#{name}-#{version}.tar.gz")
    download_file(pkg["url"], tarball)
    puts

    unless verify_sha256(tarball, pkg["sha256"])
      FileUtils.rm_rf(dest_dir)
      exit 1
    end

    step "Extracting"
    result = system("tar", "-xzf", tarball, "-C", dest_dir, "--strip-components=1")
    unless result
      error "Extraction failed."
      FileUtils.rm_rf(dest_dir)
      exit 1
    end
    ok "Extracted to #{dest_dir}"
  end

  bin_dir = File.join(dest_dir, "bin")
  if Dir.exist?(bin_dir)
    Dir.each_child(bin_dir) do |bin|
      src  = File.join(bin_dir, bin)
      link = File.join(SNAG_BIN, bin)
      FileUtils.chmod(0o755, src)
      FileUtils.ln_sf(src, link)
      ok "Linked #{Color.cyan(bin)} → #{SNAG_BIN}/"
    end
  end

  puts
  ok "#{Color.bold(name)} #{version} installed successfully!"
end

def cmd_uninstall(name)
  version = installed_version(name)
  unless version
    error "#{name} is not installed."
    exit 1
  end

  step "Uninstalling #{Color.bold(name)} #{version}"
  dest_dir = install_path(name, version)

  bin_dir = File.join(dest_dir, "bin")
  if Dir.exist?(bin_dir)
    Dir.each_child(bin_dir) do |bin|
      link = File.join(SNAG_BIN, bin)
      FileUtils.rm_f(link)
      ok "Removed #{bin}"
    end
  end

  FileUtils.rm_rf(File.join(SNAG_CELLAR, name))
  ok "#{Color.bold(name)} uninstalled."
end

def cmd_list
  unless Dir.exist?(SNAG_CELLAR)
    puts "Nothing installed yet. Try 'snag search' or 'snag info <package>'."
    return
  end

  pkgs = Dir.children(SNAG_CELLAR).select { |d| Dir.exist?(File.join(SNAG_CELLAR, d)) }.sort
  if pkgs.empty?
    puts "Nothing installed yet. Try 'snag search' or 'snag info <package>'."
    return
  end

  puts "#{Color.bold("Installed packages:")} (#{pkgs.size} total)"
  puts
  pkgs.each do |name|
    v = installed_version(name)
    puts "  #{Color.cyan(name.ljust(18))} #{v}"
  end
  puts
end

def cmd_search(query)
  packages = load_registry
  results = packages.select do |name, pkg|
    name.downcase.include?(query.downcase) ||
      pkg["description"].downcase.include?(query.downcase)
  end

  if results.empty?
    warn "No packages matching '#{query}'."
    return
  end

  puts "#{Color.bold("Search results for '#{query}':")} (#{results.size} found)"
  puts
  results.sort_by { |k, _| k }.each do |name, pkg|
    installed = installed_version(name)
    tag = installed ? Color.green(" [installed]") : ""
    puts "  #{Color.cyan(name.ljust(18))} #{pkg["version"].ljust(10)} #{pkg["description"]}#{tag}"
  end
  puts
end

def cmd_info(name)
  packages = load_registry
  unless packages.key?(name)
    error "Package '#{name}' not found."
    exit 1
  end

  pkg       = packages[name]
  installed = installed_version(name)

  puts
  puts "  #{Color.bold(Color.cyan(name))}"
  puts "  #{"─" * [name.length, 30].min}"
  puts "  Description : #{pkg["description"]}"
  puts "  Version     : #{pkg["version"]}"
  puts "  Homepage    : #{pkg["homepage"] || "N/A"}"
  puts "  URL         : #{pkg["url"]}"
  puts "  SHA256      : #{pkg["sha256"]}"
  puts "  Installed   : #{installed ? Color.green(installed) : Color.yellow("No")}"
  puts
end

def cmd_outdated
  packages = load_registry
  if packages.empty?
    warn "Registry empty. Run 'snag update'."
    return
  end

  unless Dir.exist?(SNAG_CELLAR)
    puts "Nothing installed yet."
    return
  end

  outdated = Dir.children(SNAG_CELLAR).sort.filter_map do |name|
    next unless packages.key?(name)
    current = installed_version(name)
    latest  = packages[name]["version"]
    next if current == latest
    { name: name, current: current, latest: latest }
  end

  if outdated.empty?
    ok "All packages are up to date."
    return
  end

  puts "#{Color.bold("Outdated packages:")} (#{outdated.size})"
  puts
  outdated.each do |pkg|
    puts "  #{Color.cyan(pkg[:name].ljust(18))} #{Color.yellow(pkg[:current])} → #{Color.green(pkg[:latest])}"
  end
  puts
  puts "  Run #{Color.cyan("snag upgrade")} to update all, or #{Color.cyan("snag upgrade <package>")} for one."
  puts
end

def cmd_upgrade(name = nil)
  packages = load_registry
  if packages.empty?
    warn "Registry empty. Run 'snag update' first."
    return
  end

  targets = if name
    unless packages.key?(name)
      error "Package '#{name}' not found."
      exit 1
    end
    [name]
  else
    Dir.exist?(SNAG_CELLAR) ? Dir.children(SNAG_CELLAR).select { |d| packages.key?(d) }.sort : []
  end

  if targets.empty?
    puts "Nothing installed yet."
    return
  end

  upgraded = 0
  targets.each do |pkg_name|
    current = installed_version(pkg_name)
    latest  = packages[pkg_name]["version"]

    if current.nil?
      puts
      step "Installing #{Color.bold(pkg_name)} #{Color.green(latest)} (not yet installed)"
      cmd_install(pkg_name)
      upgraded += 1
      next
    end

    if current == latest
      ok "#{pkg_name} #{current} is already up to date."
      next
    end

    puts
    step "Upgrading #{Color.bold(pkg_name)} #{Color.yellow(current)} → #{Color.green(latest)}"
    cmd_uninstall(pkg_name)
    cmd_install(pkg_name)
    upgraded += 1
  end

  puts
  ok "#{upgraded} package(s) upgraded." if upgraded > 0
end

def cmd_update
  step "Updating package registry"
  ensure_dirs

  begin
    body = fetch_url(REGISTRY_URL)
    parsed = JSON.parse(body)
    pkg_count = parsed["packages"]&.size || 0
    File.write(REGISTRY_PATH, body)
    ok "Registry updated (#{pkg_count} packages)"
  rescue => e
    error "Failed to update registry: #{e.message}"
    exit 1
  end

  puts
  step "Checking for snag updates"
  begin
    remote = fetch_url(SNAG_RAW_URL)
    local  = File.exist?(__FILE__) ? File.read(__FILE__) : ""
    if remote == local
      ok "snag is up to date"
    else
      File.write(__FILE__, remote)
      FileUtils.chmod(0o755, __FILE__)
      ok "snag updated to latest version!"
    end
  rescue => e
    warn "Could not self-update: #{e.message}"
  end
end

def cmd_doctor
  issues = 0

  check = lambda do |label, &block|
    result, detail = block.call
    if result
      puts "  #{Color.green("✓")} #{label}#{detail ? " — #{detail}" : ""}"
    else
      puts "  #{Color.red("✗")} #{label}#{detail ? " — #{detail}" : ""}"
      issues += 1
    end
  end

  puts
  puts "  #{Color.bold("snag doctor")} — checking your setup"
  puts

  # Ruby version
  check.call("Ruby installed") do
    version = RUBY_VERSION
    [true, "ruby #{version}"]
  end

  # snag binary is executable
  check.call("snag binary is executable") do
    [File.executable?(__FILE__), __FILE__]
  end

  # ~/.snag/bin in PATH
  check.call("~/.snag/bin is in PATH") do
    in_path = ENV["PATH"].split(":").any? { |p| File.expand_path(p) == File.expand_path(SNAG_BIN) }
    [in_path, in_path ? nil : "run: export PATH=\"$HOME/.snag/bin:$PATH\""]
  end

  # Cellar directory exists
  check.call("Cellar directory exists") do
    [Dir.exist?(SNAG_CELLAR), SNAG_CELLAR]
  end

  # Registry exists and is valid
  check.call("Registry is present and valid") do
    if File.exist?(REGISTRY_PATH)
      begin
        JSON.parse(File.read(REGISTRY_PATH))
        [true, REGISTRY_PATH]
      rescue JSON::ParserError
        [false, "corrupted — run 'snag update'"]
      end
    else
      [false, "missing — run 'snag update'"]
    end
  end

  # No broken symlinks in bin
  broken = []
  if Dir.exist?(SNAG_BIN)
    Dir.each_child(SNAG_BIN) do |f|
      next if f == "snag"
      link = File.join(SNAG_BIN, f)
      broken << f if File.symlink?(link) && !File.exist?(link)
    end
  end
  check.call("No broken symlinks in ~/.snag/bin") do
    broken.empty? ? [true, nil] : [false, "broken: #{broken.join(", ")} — run 'snag uninstall' and reinstall"]
  end

  # Installed packages have their binaries
  if Dir.exist?(SNAG_CELLAR)
    Dir.each_child(SNAG_CELLAR) do |pkg|
      version = installed_version(pkg)
      next unless version
      bin_dir = File.join(install_path(pkg, version), "bin")
      check.call("#{pkg} #{version} has binaries") do
        [Dir.exist?(bin_dir) && !Dir.empty?(bin_dir), install_path(pkg, version)]
      end
    end
  end

  # Internet connectivity
  check.call("GitHub reachable") do
    begin
      fetch_url("https://github.com")
      [true, nil]
    rescue
      [false, "cannot reach github.com"]
    end
  end

  puts
  if issues == 0
    puts "  #{Color.green(Color.bold("All checks passed!"))}"
  else
    puts "  #{Color.red(Color.bold("#{issues} issue(s) found."))} Fix the errors above and run 'snag doctor' again."
  end
  puts
end

def cmd_version
  puts "#{Color.bold("snag")} #{SNAG_VERSION}"
  puts "Home    : #{SNAG_HOME}"
  puts "Cellar  : #{SNAG_CELLAR}"
  puts "Binary  : #{__FILE__}"
end

def cmd_help
  puts
  puts "  #{Color.bold(Color.cyan("snag"))} #{SNAG_VERSION} — a simple package manager"
  puts
  puts "  #{Color.bold("Usage:")} snag <command> [package]"
  puts
  puts "  #{Color.bold("Commands:")}"
  cmds = [
    ["install <package[@version]>", "Download and install a package"],
    ["uninstall <package>", "Remove an installed package"],
    ["upgrade [package]",   "Upgrade one package or all installed packages"],
    ["outdated",            "Show installed packages with newer versions available"],
    ["list",                "List installed packages"],
    ["search <query>",      "Search packages by name or description"],
    ["info <package>",      "Show detailed package info"],
    ["update",              "Refresh registry and self-update snag"],
    ["doctor",              "Check your snag installation for problems"],
    ["version",             "Print version info"],
    ["help",                "Show this message"],
  ]
  cmds.each do |cmd, desc|
    puts "    #{Color.cyan(cmd.ljust(24))} #{desc}"
  end
  puts
  puts "  #{Color.bold("Examples:")}"
  puts "    snag install hello"
  puts "    snag install hello@1.0.0"
  puts "    snag search server"
  puts "    snag info quickserve"
  puts "    snag update"
  puts
end

# --- Entry point ---

command  = ARGV[0]
argument = ARGV[1]

case command
when "install"
  argument ? cmd_install(argument) : (error "Usage: snag install <package>"; exit 1)
when "uninstall", "remove", "rm"
  argument ? cmd_uninstall(argument) : (error "Usage: snag uninstall <package>"; exit 1)
when "list", "ls"
  cmd_list
when "search"
  argument ? cmd_search(argument) : (error "Usage: snag search <query>"; exit 1)
when "info"
  argument ? cmd_info(argument) : (error "Usage: snag info <package>"; exit 1)
when "upgrade"
  cmd_upgrade(argument)
when "outdated"
  cmd_outdated
when "update"
  cmd_update
when "doctor"
  cmd_doctor
when "version", "--version", "-v"
  cmd_version
when "help", "--help", "-h", nil
  cmd_help
else
  error "Unknown command: '#{command}'. Run 'snag help' for usage."
  exit 1
end
