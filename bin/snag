#!/usr/bin/env ruby
# frozen_string_literal: true

require 'net/http'
require 'json'
require 'fileutils'
require 'digest'
require 'uri'
require 'tmpdir'

SNAG_VERSION  = "1.0.4-a"
SNAG_HOME     = File.expand_path("~/.snag")
SNAG_BIN      = File.join(SNAG_HOME, "bin")
SNAG_CELLAR   = File.join(SNAG_HOME, "Cellar")
REGISTRY_URL  = "https://raw.githubusercontent.com/TDWolff-Developer-Org/Snag/refs/heads/latest/Formula/registry.json"
REGISTRY_PATH = File.join(SNAG_HOME, "registry.json")
INSTALLED_PATH = File.join(SNAG_HOME, "installed.json")
SNAG_RAW_URL  = "https://raw.githubusercontent.com/TDWolff-Developer-Org/Snag/refs/heads/latest/bin/snag"

module Color
  RESET  = "\e[0m"
  RED    = "\e[31m"
  GREEN  = "\e[32m"
  YELLOW = "\e[33m"
  BLUE   = "\e[34m"
  CYAN   = "\e[36m"
  BOLD   = "\e[1m"

  def self.red(s)    = "#{RED}#{s}#{RESET}"
  def self.green(s)  = "#{GREEN}#{s}#{RESET}"
  def self.yellow(s) = "#{YELLOW}#{s}#{RESET}"
  def self.blue(s)   = "#{BLUE}#{s}#{RESET}"
  def self.cyan(s)   = "#{CYAN}#{s}#{RESET}"
  def self.bold(s)   = "#{BOLD}#{s}#{RESET}"
end

def step(msg)  = puts("#{Color.blue("==>")} #{Color.bold(msg)}")
def ok(msg)    = puts("#{Color.green("✓")} #{msg}")
def warn(msg)  = puts("#{Color.yellow("⚠")} #{msg}")
def error(msg) = puts("#{Color.red("✗")} #{msg}")
def info(msg)  = puts("  #{msg}")

def ensure_dirs
  [SNAG_HOME, SNAG_BIN, SNAG_CELLAR].each { |d| FileUtils.mkdir_p(d) }
end

NO_CACHE_HEADERS = { "Cache-Control" => "no-cache", "Pragma" => "no-cache" }.freeze

def current_platform
  os  = `uname -s 2>/dev/null`.strip.downcase
  cpu = `uname -m 2>/dev/null`.strip.downcase
  os  = case os
        when "darwin" then "darwin"
        when "linux"  then "linux"
        else os
        end
  cpu = case cpu
        when "arm64", "aarch64" then "arm64"
        when "x86_64", "amd64"  then "x86_64"
        else cpu
        end
  "#{os}-#{cpu}"
rescue
  "unknown"
end

PLATFORM = current_platform.freeze

def fetch_url(url, limit = 5)
  raise "Too many redirects" if limit == 0
  uri = URI.parse(url)
  response = Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == 'https') do |http|
    req = Net::HTTP::Get.new(uri.request_uri)
    NO_CACHE_HEADERS.each { |k, v| req[k] = v }
    http.request(req)
  end
  case response.code
  when "200" then response.body
  when "301", "302", "307", "308" then fetch_url(response['location'], limit - 1)
  else raise "HTTP #{response.code}: #{url}"
  end
end

def download_file(url, dest, limit = 5)
  raise "Too many redirects" if limit == 0
  uri = URI.parse(url)
  Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == 'https') do |http|
    http.request(Net::HTTP::Get.new(uri.request_uri)) do |response|
      case response.code
      when "301", "302", "307", "308"
        return download_file(response['location'], dest, limit - 1)
      when "200"
        File.open(dest, 'wb') { |f| response.read_body { |chunk| f.write(chunk) } }
      else
        raise "HTTP #{response.code}: #{url}"
      end
    end
  end
end

def verify_sha256(path, expected)
  step "Verifying SHA256"
  actual = Digest::SHA256.file(path).hexdigest
  if actual == expected
    ok "SHA256 verified"
    true
  else
    error "SHA256 mismatch!"
    info "Expected: #{expected}"
    info "Got:      #{actual}"
    false
  end
end

def load_registry
  unless File.exist?(REGISTRY_PATH)
    warn "Registry not found. Run 'snag update' to fetch it."
    return {}
  end
  JSON.parse(File.read(REGISTRY_PATH))["packages"] || {}
rescue JSON::ParserError
  error "Registry is corrupted. Run 'snag update'."
  {}
end

def installed_version(name)
  dir = File.join(SNAG_CELLAR, name)
  return nil unless Dir.exist?(dir)
  versions = Dir.children(dir).sort
  versions.last
end

def install_path(name, version)
  File.join(SNAG_CELLAR, name, version)
end

# --- Install ledger (~/.snag/installed.json) ---

# Pure read of the ledger. No filesystem inference — that lives in
# migrate_installed_ledger which runs exactly once.
def load_installed
  return {} unless File.exist?(INSTALLED_PATH)
  JSON.parse(File.read(INSTALLED_PATH)) rescue {}
end

# One-time migration: if installed.json doesn't exist yet but Cellar already
# has packages, mark them all as "explicit" so they're never auto-orphaned.
# Idempotent — re-running after the file exists is a no-op.
def migrate_installed_ledger
  return if File.exist?(INSTALLED_PATH)
  return unless Dir.exist?(SNAG_CELLAR)
  data = {}
  Dir.children(SNAG_CELLAR).each do |pkg|
    v = installed_version(pkg)
    next unless v
    data[pkg] = { "version" => v, "installed_as" => "explicit" }
  end
  save_installed(data) unless data.empty?
end

def save_installed(data)
  ensure_dirs
  File.write(INSTALLED_PATH, JSON.pretty_generate(data) + "\n")
end

def mark_installed(name, version, reason)
  data = load_installed
  # Don't demote an explicit install to dependency
  if data[name] && data[name]["installed_as"] == "explicit" && reason == "dependency"
    reason = "explicit"
  end
  data[name] = { "version" => version, "installed_as" => reason }
  save_installed(data)
end

def unmark_installed(name)
  data = load_installed
  data.delete(name)
  save_installed(data)
end

# Walks the dep tree of every "explicit" package. Anything reachable is
# "needed". Anything marked "dependency" that isn't reachable is an orphan.
def find_orphans
  installed = load_installed
  packages  = load_registry
  needed    = []

  installed.each do |name, info|
    next unless info["installed_as"] == "explicit"
    queue = [name]
    until queue.empty?
      current = queue.shift
      next if needed.include?(current)
      needed << current
      next unless packages.key?(current)
      (packages[current]["depends_on"] || []).each { |d| queue << d }
    end
  end

  installed.keys.select do |name|
    installed[name]["installed_as"] == "dependency" && !needed.include?(name)
  end.sort
end

# --- Commands ---

def levenshtein(a, b)
  s, t = a.downcase, b.downcase
  d = Array.new(s.length + 1) { |i| Array.new(t.length + 1) { |j| i.zero? ? j : j.zero? ? i : 0 } }
  (1..s.length).each do |i|
    (1..t.length).each do |j|
      d[i][j] = s[i-1] == t[j-1] ? d[i-1][j-1] : 1 + [d[i-1][j], d[i][j-1], d[i-1][j-1]].min
    end
  end
  d[s.length][t.length]
end

def suggest_similar(name, candidates)
  return if candidates.empty?
  best = candidates.min_by { |c| levenshtein(name, c) }
  return unless best
  distance = levenshtein(name, best)
  if distance <= [name.length / 2, 3].max
    puts
    info "Are you trying to install #{Color.cyan(best)}?"
    info "Run: #{Color.bold("snag install #{best}")}"
  else
    info "Run 'snag search #{name}' to browse available packages."
  end
end

# Build a topologically-sorted install order: deps first, target last.
# Raises RuntimeError on cycles or missing packages.
def resolve_deps(name, packages, visiting = [], resolved = [])
  return resolved if resolved.include?(name)

  if visiting.include?(name)
    cycle = visiting[visiting.index(name)..] + [name]
    raise "Dependency cycle detected: #{cycle.join(" → ")}"
  end

  unless packages.key?(name)
    raise "Missing dependency: '#{name}' is not in the registry"
  end

  visiting = visiting + [name]
  deps = packages[name]["depends_on"] || []
  deps.each { |d| resolve_deps(d, packages, visiting, resolved) }
  resolved << name unless resolved.include?(name)
  resolved
end

def cmd_install(name, pinned_version = nil, target_reason = "explicit")
  if name.include?("@")
    name, pinned_version = name.split("@", 2)
  end

  packages = load_registry
  unless packages.key?(name)
    error "Package '#{name}' not found."
    suggest_similar(name, packages.keys)
    exit 1
  end

  begin
    install_order = resolve_deps(name, packages)
  rescue RuntimeError => e
    error e.message
    exit 1
  end

  deps = install_order[0..-2]
  unless deps.empty?
    info "#{Color.bold(name)} depends on: #{deps.map { |d| Color.cyan(d) }.join(", ")}"
    puts
  end

  install_order.each do |pkg_name|
    pin = pkg_name == name ? pinned_version : nil
    reason = pkg_name == name ? target_reason : "dependency"
    install_resolved(pkg_name, packages, pin, reason)
  end
end

def install_resolved(name, packages, pinned_version = nil, reason = "explicit")
  pkg            = packages[name]
  latest_version = pkg["version"]

  if pinned_version && pinned_version != latest_version
    error "Version #{pinned_version} of '#{name}' is not available."
    info  "Available version: #{Color.green(latest_version)}"
    info  "Install it with:   snag install #{name}@#{latest_version}"
    exit 1
  end

  version  = latest_version
  existing = installed_version(name)

  if existing == version
    ok "#{name} #{version} is already installed."
    mark_installed(name, version, reason)
    return
  end

  # Resolve URL and SHA256 — platform-specific binary or universal script
  if pkg["platforms"]
    platform_data = pkg["platforms"][PLATFORM]
    unless platform_data
      supported = pkg["platforms"].keys.join(", ")
      error "#{name} is not available for #{PLATFORM}."
      info  "Supported platforms: #{supported}"
      exit 1
    end
    pkg_url    = platform_data["url"]
    pkg_sha256 = platform_data["sha256"]
  else
    pkg_url    = pkg["url"]
    pkg_sha256 = pkg["sha256"]
  end

  step "Installing #{Color.bold(name)} #{version}"
  info pkg["description"]
  puts

  ensure_dirs
  dest_dir = install_path(name, version)
  FileUtils.mkdir_p(dest_dir)

  Dir.mktmpdir do |tmp|
    tarball = File.join(tmp, "#{name}-#{version}.tar.gz")
    download_file(pkg_url, tarball)
    puts

    unless verify_sha256(tarball, pkg_sha256)
      FileUtils.rm_rf(dest_dir)
      exit 1
    end

    step "Extracting"
    result = system("tar", "-xzf", tarball, "-C", dest_dir, "--strip-components=1")
    unless result
      error "Extraction failed."
      FileUtils.rm_rf(dest_dir)
      exit 1
    end
    ok "Extracted to #{dest_dir}"
  end

  if pkg["binaries"]
    # Explicit binary list — used for third-party tarballs that don't have a bin/ dir
    pkg["binaries"].each do |b|
      src = File.join(dest_dir, b)
      unless File.exist?(src)
        warn "Binary not found in tarball: #{b}"
        next
      end
      link_name = File.basename(b)
      link = File.join(SNAG_BIN, link_name)
      FileUtils.chmod(0o755, src)
      FileUtils.ln_sf(src, link)
      ok "Linked #{Color.cyan(link_name)} → #{SNAG_BIN}/"
    end
  else
    # Default: symlink everything in bin/
    bin_dir = File.join(dest_dir, "bin")
    if Dir.exist?(bin_dir)
      Dir.each_child(bin_dir) do |bin|
        src  = File.join(bin_dir, bin)
        link = File.join(SNAG_BIN, bin)
        FileUtils.chmod(0o755, src)
        FileUtils.ln_sf(src, link)
        ok "Linked #{Color.cyan(bin)} → #{SNAG_BIN}/"
      end
    end
  end

  mark_installed(name, version, reason)

  puts
  ok "#{Color.bold(name)} #{version} installed successfully!"
end

# Raw uninstall — no orphan check or prompt. Used by cmd_uninstall (which adds
# the orphan prompt) and by upgrade flows that need to remove + reinstall
# without surfacing an unrelated cleanup question to the user.
def uninstall_one(name)
  version = installed_version(name)
  return false unless version

  step "Uninstalling #{Color.bold(name)} #{version}"
  dest_dir = install_path(name, version)

  packages = load_registry
  pkg = packages[name]

  if pkg && pkg["binaries"]
    pkg["binaries"].each do |b|
      link_name = File.basename(b)
      link = File.join(SNAG_BIN, link_name)
      next unless File.symlink?(link) || File.exist?(link)
      FileUtils.rm_f(link)
      ok "Removed #{link_name}"
    end
  else
    bin_dir = File.join(dest_dir, "bin")
    if Dir.exist?(bin_dir)
      Dir.each_child(bin_dir) do |bin|
        link = File.join(SNAG_BIN, bin)
        FileUtils.rm_f(link)
        ok "Removed #{bin}"
      end
    end
  end

  FileUtils.rm_rf(File.join(SNAG_CELLAR, name))
  unmark_installed(name)
  ok "#{Color.bold(name)} uninstalled."
  true
end

def cmd_uninstall(name)
  unless installed_version(name)
    error "#{name} is not installed."
    exit 1
  end

  uninstall_one(name)

  orphans = find_orphans
  return if orphans.empty?

  puts
  info "Orphaned dependencies (no longer needed): #{orphans.map { |o| Color.cyan(o) }.join(", ")}"
  print "  Remove them too? [y/N] "
  answer = $stdin.gets&.strip&.downcase
  if %w[y yes].include?(answer)
    puts
    orphans.each { |o| uninstall_one(o); puts }
    ok "#{orphans.size} orphaned package(s) removed."
  else
    info "Run 'snag autoremove' later to clean them up."
  end
end

def cmd_autoremove
  orphans = find_orphans
  if orphans.empty?
    ok "No orphaned dependencies to remove."
    return
  end

  puts
  info "Orphaned dependencies: #{orphans.map { |o| Color.cyan(o) }.join(", ")}"
  print "  Remove all? [y/N] "
  answer = $stdin.gets&.strip&.downcase
  unless %w[y yes].include?(answer)
    info "Cancelled."
    return
  end

  puts
  orphans.each { |o| uninstall_one(o); puts }
  ok "#{orphans.size} package(s) removed."
end

def cmd_list
  unless Dir.exist?(SNAG_CELLAR)
    puts "Nothing installed yet. Try 'snag search' or 'snag info <package>'."
    return
  end

  pkgs = Dir.children(SNAG_CELLAR).select { |d| Dir.exist?(File.join(SNAG_CELLAR, d)) }.sort
  if pkgs.empty?
    puts "Nothing installed yet. Try 'snag search' or 'snag info <package>'."
    return
  end

  installed = load_installed
  puts "#{Color.bold("Installed packages:")} (#{pkgs.size} total)"
  puts
  pkgs.each do |name|
    v = installed_version(name)
    reason = installed.dig(name, "installed_as") || "explicit"
    tag = reason == "dependency" ? Color.yellow(" [dep]") : ""
    puts "  #{Color.cyan(name.ljust(18))} #{v}#{tag}"
  end
  puts
end

def cmd_search(query)
  packages = load_registry
  results = packages.select do |name, pkg|
    name.downcase.include?(query.downcase) ||
      pkg["description"].downcase.include?(query.downcase)
  end

  if results.empty?
    warn "No packages matching '#{query}'."
    return
  end

  puts "#{Color.bold("Search results for '#{query}':")} (#{results.size} found)"
  puts
  results.sort_by { |k, _| k }.each do |name, pkg|
    installed = installed_version(name)
    tag = installed ? Color.green(" [installed]") : ""
    puts "  #{Color.cyan(name.ljust(18))} #{pkg["version"].ljust(10)} #{pkg["description"]}#{tag}"
  end
  puts
end

def cmd_info(name)
  packages = load_registry
  unless packages.key?(name)
    error "Package '#{name}' not found."
    exit 1
  end

  pkg       = packages[name]
  installed = installed_version(name)

  puts
  puts "  #{Color.bold(Color.cyan(name))}"
  puts "  #{"─" * [name.length, 30].min}"
  puts "  Description : #{pkg["description"]}"
  puts "  Version     : #{pkg["version"]}"
  puts "  Homepage    : #{pkg["homepage"] || "N/A"}"
  deps = pkg["depends_on"] || []
  puts "  Depends on  : #{deps.empty? ? Color.cyan("none") : deps.map { |d| Color.cyan(d) }.join(", ")}"
  if pkg["platforms"]
    puts "  Type        : binary"
    puts "  Platforms   : #{pkg["platforms"].keys.join(", ")}"
    pdata = pkg["platforms"][PLATFORM]
    if pdata
      puts "  URL         : #{pdata["url"]}"
      puts "  SHA256      : #{pdata["sha256"]}"
    else
      puts "  #{Color.yellow("Not available for #{PLATFORM}")}"
    end
  else
    puts "  Type        : script"
    puts "  URL         : #{pkg["url"]}"
    puts "  SHA256      : #{pkg["sha256"]}"
  end
  puts "  Installed   : #{installed ? Color.green(installed) : Color.yellow("No")}"
  puts
end

def cmd_outdated
  packages = load_registry
  if packages.empty?
    warn "Registry empty. Run 'snag update'."
    return
  end

  unless Dir.exist?(SNAG_CELLAR)
    puts "Nothing installed yet."
    return
  end

  outdated = Dir.children(SNAG_CELLAR).sort.filter_map do |name|
    next unless packages.key?(name)
    current = installed_version(name)
    latest  = packages[name]["version"]
    next if current == latest
    { name: name, current: current, latest: latest }
  end

  if outdated.empty?
    ok "All packages are up to date."
    return
  end

  puts "#{Color.bold("Outdated packages:")} (#{outdated.size})"
  puts
  outdated.each do |pkg|
    puts "  #{Color.cyan(pkg[:name].ljust(18))} #{Color.yellow(pkg[:current])} → #{Color.green(pkg[:latest])}"
  end
  puts
  puts "  Run #{Color.cyan("snag upgrade")} to update all, or #{Color.cyan("snag upgrade <package>")} for one."
  puts
end

def cmd_upgrade(name = nil)
  packages = load_registry
  if packages.empty?
    warn "Registry empty. Run 'snag update' first."
    return
  end

  targets = if name
    unless packages.key?(name)
      error "Package '#{name}' not found."
      exit 1
    end
    [name]
  else
    Dir.exist?(SNAG_CELLAR) ? Dir.children(SNAG_CELLAR).select { |d| packages.key?(d) }.sort : []
  end

  if targets.empty?
    puts "Nothing installed yet."
    return
  end

  upgraded = 0
  targets.each do |pkg_name|
    current = installed_version(pkg_name)
    latest  = packages[pkg_name]["version"]

    if current.nil?
      puts
      step "Installing #{Color.bold(pkg_name)} #{Color.green(latest)} (not yet installed)"
      cmd_install(pkg_name)
      upgraded += 1
      next
    end

    if current == latest
      ok "#{pkg_name} #{current} is already up to date."
      next
    end

    puts
    step "Upgrading #{Color.bold(pkg_name)} #{Color.yellow(current)} → #{Color.green(latest)}"
    prior_reason = load_installed.dig(pkg_name, "installed_as") || "explicit"
    uninstall_one(pkg_name)
    cmd_install(pkg_name, nil, prior_reason)
    upgraded += 1
  end

  puts
  ok "#{upgraded} package(s) upgraded." if upgraded > 0
end

def cmd_update
  step "Updating package registry"
  ensure_dirs

  # Use curl for all update fetches — it bypasses CDN caches reliably
  unless system("command -v curl > /dev/null 2>&1")
    error "curl is required for updates but was not found."
    exit 1
  end

  registry_tmp = File.join(SNAG_HOME, "registry.json.tmp")
  result = system("curl", "-fsSL",
                  "-H", "Cache-Control: no-cache",
                  "-H", "Pragma: no-cache",
                  REGISTRY_URL, "-o", registry_tmp)
  remote_snag_version = nil
  if result && File.exist?(registry_tmp)
    begin
      parsed = JSON.parse(File.read(registry_tmp))
      pkg_count = parsed["packages"]&.size || 0
      remote_snag_version = parsed["snag_version"]
      FileUtils.mv(registry_tmp, REGISTRY_PATH)
      ok "Registry updated"
    rescue JSON::ParserError
      FileUtils.rm_f(registry_tmp)
      error "Downloaded registry is corrupted. Try again."
      exit 1
    end
  else
    FileUtils.rm_f(registry_tmp)
    error "Failed to download registry."
    exit 1
  end

  puts
  step "Checking for snag updates"
  if remote_snag_version.nil?
    warn "Registry has no snag_version field — skipping self-update check"
  elsif remote_snag_version == SNAG_VERSION
    ok "snag #{SNAG_VERSION} is up to date"
  else
    info "Updating snag #{Color.yellow(SNAG_VERSION)} → #{Color.green(remote_snag_version)}"
    begin
      snag_tmp = File.join(SNAG_HOME, "snag.tmp")
      result = system("curl", "-fsSL",
                      "-H", "Cache-Control: no-cache",
                      "-H", "Pragma: no-cache",
                      SNAG_RAW_URL, "-o", snag_tmp)
      raise "curl failed" unless result && File.exist?(snag_tmp)

      FileUtils.mv(snag_tmp, __FILE__)
      FileUtils.chmod(0o755, __FILE__)
      ok "snag updated to #{remote_snag_version}!"
    rescue => e
      FileUtils.rm_f(snag_tmp) rescue nil
      warn "Could not self-update: #{e.message}"
    end
  end

  # Upgrade any installed packages that have newer versions in the registry
  puts
  step "Upgrading installed packages"
  packages = load_registry
  upgraded = 0

  if Dir.exist?(SNAG_CELLAR)
    Dir.children(SNAG_CELLAR).sort.each do |pkg_name|
      current = installed_version(pkg_name)
      next unless current
      latest = packages.dig(pkg_name, "version")
      next unless latest

      if current == latest
        ok "#{pkg_name} #{current} is up to date"
      else
        warn "#{pkg_name} #{current} → #{Color.green(latest)}"
        prior_reason = load_installed.dig(pkg_name, "installed_as") || "explicit"
        uninstall_one(pkg_name)
        cmd_install(pkg_name, nil, prior_reason)
        upgraded += 1
      end
    end
  end

  if upgraded == 0
    ok "All packages up to date" unless Dir.exist?(SNAG_CELLAR) && !Dir.children(SNAG_CELLAR).empty?
  else
    puts
    ok "#{upgraded} package(s) upgraded."
  end
end

def dir_size(path)
  total = 0
  Dir.glob(File.join(path, "**", "*"), File::FNM_DOTMATCH).each do |f|
    total += File.size(f) if File.file?(f)
  end
  total
rescue
  0
end

def format_bytes(n)
  return "0 B" if n.nil? || n == 0
  units = %w[B KB MB GB]
  i = 0
  size = n.to_f
  while size >= 1024 && i < units.size - 1
    size /= 1024
    i += 1
  end
  "%.1f %s" % [size, units[i]]
end

def cmd_cleanup(dry_run = false)
  ensure_dirs
  puts
  puts "  #{Color.bold("snag cleanup")}#{dry_run ? " #{Color.yellow("(dry run)")}" : ""}"
  puts

  total_freed = 0
  removed_versions = 0

  # 1. Old versions in Cellar
  step "Old package versions"
  if Dir.exist?(SNAG_CELLAR)
    Dir.children(SNAG_CELLAR).sort.each do |pkg|
      pkg_dir = File.join(SNAG_CELLAR, pkg)
      next unless Dir.exist?(pkg_dir)
      versions = Dir.children(pkg_dir).sort
      next if versions.size <= 1

      keep = versions.last
      versions[0..-2].each do |v|
        path = File.join(pkg_dir, v)
        size = dir_size(path)
        total_freed += size
        removed_versions += 1
        if dry_run
          info "Would remove #{Color.cyan(pkg)} #{Color.yellow(v)} (#{format_bytes(size)}) — keeping #{Color.green(keep)}"
        else
          FileUtils.rm_rf(path)
          ok "Removed #{Color.cyan(pkg)} #{Color.yellow(v)} (#{format_bytes(size)})"
        end
      end
    end
  end
  ok "No old versions to clean" if removed_versions == 0

  # 2. Broken symlinks in bin/
  puts
  step "Broken symlinks"
  broken = []
  if Dir.exist?(SNAG_BIN)
    Dir.each_child(SNAG_BIN) do |f|
      next if f == "snag"
      link = File.join(SNAG_BIN, f)
      broken << f if File.symlink?(link) && !File.exist?(link)
    end
  end
  if broken.empty?
    ok "No broken symlinks"
  elsif dry_run
    broken.each { |f| info "Would remove broken symlink #{Color.yellow(f)}" }
  else
    broken.each do |f|
      FileUtils.rm_f(File.join(SNAG_BIN, f))
      ok "Removed broken symlink #{Color.yellow(f)}"
    end
  end

  # 3. Temp files
  puts
  step "Temporary files"
  tmp_files = Dir.glob(File.join(SNAG_HOME, "*.tmp"))
  if tmp_files.empty?
    ok "No temp files"
  else
    tmp_files.each do |f|
      size = File.size(f) rescue 0
      total_freed += size
      if dry_run
        info "Would remove #{f} (#{format_bytes(size)})"
      else
        FileUtils.rm_f(f)
        ok "Removed #{File.basename(f)} (#{format_bytes(size)})"
      end
    end
  end

  puts
  if dry_run
    info "Dry run — nothing was removed."
    info "Run #{Color.cyan("snag cleanup")} (without --dry-run) to apply."
  elsif total_freed > 0
    ok "Freed #{Color.bold(format_bytes(total_freed))} total"
  else
    ok "Already clean"
  end
  puts
end

def cmd_doctor
  issues = 0

  check = lambda do |label, &block|
    result, detail = block.call
    if result
      puts "  #{Color.green("✓")} #{label}#{detail ? " — #{detail}" : ""}"
    else
      puts "  #{Color.red("✗")} #{label}#{detail ? " — #{detail}" : ""}"
      issues += 1
    end
  end

  puts
  puts "  #{Color.bold("snag doctor")} — checking your setup"
  puts

  # Ruby version
  check.call("Ruby installed") do
    version = RUBY_VERSION
    [true, "ruby #{version}"]
  end

  # snag binary is executable
  check.call("snag binary is executable") do
    [File.executable?(__FILE__), __FILE__]
  end

  # ~/.snag/bin in PATH
  check.call("~/.snag/bin is in PATH") do
    in_path = ENV["PATH"].split(":").any? { |p| File.expand_path(p) == File.expand_path(SNAG_BIN) }
    [in_path, in_path ? nil : "run: export PATH=\"$HOME/.snag/bin:$PATH\""]
  end

  # Cellar directory exists
  check.call("Cellar directory exists") do
    [Dir.exist?(SNAG_CELLAR), SNAG_CELLAR]
  end

  # Registry exists and is valid
  check.call("Registry is present and valid") do
    if File.exist?(REGISTRY_PATH)
      begin
        JSON.parse(File.read(REGISTRY_PATH))
        [true, REGISTRY_PATH]
      rescue JSON::ParserError
        [false, "corrupted — run 'snag update'"]
      end
    else
      [false, "missing — run 'snag update'"]
    end
  end

  # No broken symlinks in bin
  broken = []
  if Dir.exist?(SNAG_BIN)
    Dir.each_child(SNAG_BIN) do |f|
      next if f == "snag"
      link = File.join(SNAG_BIN, f)
      broken << f if File.symlink?(link) && !File.exist?(link)
    end
  end
  check.call("No broken symlinks in ~/.snag/bin") do
    broken.empty? ? [true, nil] : [false, "broken: #{broken.join(", ")} — run 'snag uninstall' and reinstall"]
  end

  # Installed packages have their binaries
  if Dir.exist?(SNAG_CELLAR)
    Dir.each_child(SNAG_CELLAR) do |pkg|
      version = installed_version(pkg)
      next unless version
      bin_dir = File.join(install_path(pkg, version), "bin")
      check.call("#{pkg} #{version} has binaries") do
        [Dir.exist?(bin_dir) && !Dir.empty?(bin_dir), install_path(pkg, version)]
      end
    end
  end

  # Internet connectivity
  check.call("GitHub reachable") do
    begin
      fetch_url("https://github.com")
      [true, nil]
    rescue
      [false, "cannot reach github.com"]
    end
  end

  puts
  if issues == 0
    puts "  #{Color.green(Color.bold("All checks passed!"))}"
  else
    puts "  #{Color.red(Color.bold("#{issues} issue(s) found."))} Fix the errors above and run 'snag doctor' again."
  end
  puts
end

def cmd_self_uninstall
  puts
  puts "  #{Color.bold(Color.red("⚠  Uninstall Snag"))}"
  puts
  puts "  This will:"
  puts "    • Remove #{SNAG_HOME}"
  puts "    • Remove all installed packages"
  puts "    • Strip PATH entries from your shell config"
  puts
  print "  Are you sure? [y/N] "
  answer = $stdin.gets&.strip&.downcase
  unless %w[y yes].include?(answer)
    puts
    info "Uninstall cancelled."
    return
  end

  puts
  print "  #{Color.yellow("Are you REALLY sure?")} This cannot be undone. [y/N] "
  answer = $stdin.gets&.strip&.downcase
  unless %w[y yes].include?(answer)
    puts
    info "Uninstall cancelled."
    return
  end

  puts
  step "Removing #{SNAG_HOME}"
  if Dir.exist?(SNAG_HOME)
    FileUtils.rm_rf(SNAG_HOME)
    ok "Removed #{SNAG_HOME}"
  else
    warn "#{SNAG_HOME} does not exist"
  end

  step "Cleaning up shell config"
  shell_files = [
    File.expand_path("~/.zshrc"),
    File.expand_path("~/.bashrc"),
    File.expand_path("~/.bash_profile"),
    File.expand_path("~/.config/fish/config.fish"),
  ]

  shell_files.each do |rc|
    next unless File.exist?(rc)
    content = File.read(rc)
    new_content = content.lines.reject { |l|
      l.include?(".snag/bin") || l.strip == "# Snag package manager"
    }.join
    new_content = new_content.gsub(/\n{3,}/, "\n\n")
    if content != new_content
      File.write(rc, new_content)
      ok "Cleaned #{rc}"
    end
  end

  puts
  ok "Snag uninstalled."
  info "Open a new terminal — the snag command will be gone."
  puts
end

def cmd_version
  puts "#{Color.bold("snag")} #{SNAG_VERSION} #{Color.cyan("[#{PLATFORM}]")}"
  puts "Home     : #{SNAG_HOME}"
  puts "Cellar   : #{SNAG_CELLAR}"
  puts "Binary   : #{__FILE__}"
  puts "Platform : #{PLATFORM}"
end


def cmd_help
  puts
  puts "  #{Color.bold(Color.cyan("snag"))} #{SNAG_VERSION} — a simple package manager"
  puts
  puts "  #{Color.bold("Usage:")} snag <command> [package]"
  puts
  puts "  #{Color.bold("Commands:")}"
  cmds = [
    ["install <package[@version]>", "Download and install a package"],
    ["uninstall <package>", "Remove an installed package"],
    ["upgrade [package]",   "Upgrade one package or all installed packages"],
    ["outdated",            "Show installed packages with newer versions available"],
    ["list",                "List installed packages"],
    ["search <query>",      "Search packages by name or description"],
    ["info <package>",      "Show detailed package info"],
    ["update",              "Refresh registry and self-update snag"],
    ["doctor",              "Check your snag installation for problems"],
    ["cleanup [--dry-run]",  "Remove old versions, broken symlinks, and temp files"],
    ["autoremove",           "Remove dependencies no longer required by any explicit package"],
    ["self-uninstall",      "Completely remove snag from this machine"],
    ["version",             "Print version info"],
    ["help",                "Show this message"],
  ]
  cmds.each do |cmd, desc|
    puts "    #{Color.cyan(cmd.ljust(24))} #{desc}"
  end
  puts
  puts "  #{Color.bold("Examples:")}"
  puts "    snag install myip"
  puts "    snag install snagtools"
  puts "    snag search ip"
  puts "    snag info snagtools"
  puts "    snag update"
  puts
end

# --- Entry point ---

migrate_installed_ledger

command  = ARGV[0]
argument = ARGV[1]

case command
when "install"
  argument ? cmd_install(argument) : (error "Usage: snag install <package>"; exit 1)
when "uninstall", "remove", "rm"
  argument ? cmd_uninstall(argument) : (error "Usage: snag uninstall <package>"; exit 1)
when "list", "ls"
  cmd_list
when "search"
  argument ? cmd_search(argument) : (error "Usage: snag search <query>"; exit 1)
when "info"
  argument ? cmd_info(argument) : (error "Usage: snag info <package>"; exit 1)
when "upgrade"
  cmd_upgrade(argument)
when "outdated"
  cmd_outdated
when "update"
  cmd_update
when "doctor"
  cmd_doctor
when "cleanup"
  cmd_cleanup(argument == "--dry-run")
when "autoremove"
  cmd_autoremove
when "self-uninstall", "--uninstall"
  cmd_self_uninstall
when "version", "--version", "-v"
  cmd_version
when "help", "--help", "-h", nil
  cmd_help
else
  error "Unknown command: '#{command}'. Run 'snag help' for usage."
  exit 1
end
